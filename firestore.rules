rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // List of authorized email addresses
    // Add or remove emails as needed
    function isAuthorizedUser() {
      return request.auth != null &&
        request.auth.token.email in [
          'jon@delawarefencesolutions.com',
          'karl@delawarefencesolutions.com',
          'kevin@delawarefencesolutions.com',
          'info@delawarefencesolutions.com'
        ];
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Notifications - scoped to recipient/sender only
    match /notifications/{notifId} {
      // Only the recipient can read their own notifications
      allow read: if isAuthorizedUser() && request.auth.token.email == resource.data.toEmail;
      // Only create if fromEmail matches the authenticated user (prevents impersonation)
      allow create: if isAuthorizedUser() && request.auth.token.email == request.resource.data.fromEmail;
      // Only the recipient can mark notifications as read
      allow update: if isAuthorizedUser() && request.auth.token.email == resource.data.toEmail;
      allow delete: if isAuthorizedUser() && request.auth.token.email == resource.data.toEmail;
    }

    // All other collections - only authorized users can read/write
    match /{document=**} {
      allow read, write: if isAuthorizedUser();
    }
  }
}
